# 复制为本地配置：cp .env.example .env
# make run / make worker / make test 会 source 此文件。
# 集群用 ConfigMap minitube + Secret minitube，不要把真实密钥提交进 git。
# 完整清单见 docs/config.md。

# --- API（api/internal/config）---
HTTP_ADDR=:8080
DATABASE_URL=postgres://minitube:minitube@127.0.0.1:5433/minitube?sslmode=disable
JWT_SECRET=dev-change-me
PUBLIC_BASE_URL=http://127.0.0.1:8080
UPLOAD_DIR=./data/uploads
RTMP_BASE_URL=rtmp://127.0.0.1:1935/live
SRS_HLS_DIR=./data/srs-hls
LIVE_HLS_DIR=./data/live-hls
SRS_HOOK_SECRET=dev-srs-hook
LIVE_IDLE_TTL=1h
ACCESS_TOKEN_TTL=168h
REFRESH_TOKEN_TTL=720h
EMAIL_TOKEN_TTL=24h

# 站点 /admin 种口令（空=不自动种库）。公网登录还要 TOTP。
ADMIN_PASSWORD=
# 仍可用 MiniTube 用户 JWT 调 PATCH /v1/admin/site 的 uuid 列表（逗号分隔）
ADMIN_USER_IDS=

# 码流边缘 TLS（本机一般留空，不听 18080）
MEDIA_EDGE_TLS_ADDR=
MEDIA_EDGE_TLS_CERT=/data/ctc-tls/fullchain.pem
MEDIA_EDGE_TLS_KEY=/data/ctc-tls/privkey.pem
MEDIA_EDGE_TLS_HOST=ctc.minitube.19121122.xyz

# --- worker / 转码 ---
# 本机默认 CPU。k8s：h264_nvenc / h264_qsv / h264_vaapi，RANK 1-4。
TRANSCODE_ENCODER=libx264
TRANSCODE_PRESET=veryfast
TRANSCODE_RANK=0
TRANSCODE_MAX_HEIGHT=1080
TRANSCODE_WORKER_ID=
TRANSCODE_JOB_TIMEOUT=
VAAPI_DEVICE=/dev/dri/renderD128

# --- 脚本（cutover / build-images，可选）---
GOPROXY=https://goproxy.cn,direct
MASTER_IP=192.168.43.111
NFS_SERVER=192.168.43.131
# cutover.sh 写入 k8s Secret 时用；本地 compose Postgres 密码已是 minitube
POSTGRES_PASSWORD=minitube
